<section id="paquetes" class="py-24 bg-gradient-to-br from-accent/25 via-rose-cream/30 to-cream">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Título -->
    <h2 class="text-3xl md:text-4xl font-bold text-grape text-center mb-4">
      Paquetes Nutri-Break
    </h2>

    <p class="text-center text-gray-600 mb-16">
      Opciones saludables para cada tipo de evento académico
    </p>

    <!-- Paquetes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Wellness Basic -->
      <div class="bg-white rounded-2xl shadow-md p-8 flex flex-col">
        <h3 class="text-2xl font-semibold text-primary mb-2 flex items-center gap-2">
            🌿 Wellness Basic
        </h3>

        <p class="text-3xl font-bold text-dark mb-6">
          $55 <span class="text-base font-normal text-gray-500">/ persona</span>
        </p>

        <ul class="space-y-3 text-gray-700 mb-8">
          <li>✓ Café de origen</li>
          <li>✓ Té detox natural</li>
          <li>✓ Snacks saludables</li>
          <li>✓ Agua vitaminada</li>
        </ul>

        <button
            data-paquete="Wellness Basic"
            class="seleccionar-paquete mt-auto w-full border-2 border-primary text-primary
                 py-3 rounded-xl font-semibold hover:bg-primary
                 hover:text-white transition"
        >
          Seleccionar paquete
        </button>
      </div>

      <!-- Wellness Pro -->
      <div class="bg-white rounded-2xl shadow-xl p-8 flex flex-col">
        <h3 class="text-2xl font-semibold text-primary mb-2 flex items-center gap-2">
            ⭐ Wellness Pro
        </h3>

        <p class="text-3xl font-bold text-dark mb-6">
          $130 <span class="text-base font-normal text-gray-500">/ persona</span>
        </p>

        <ul class="space-y-3 text-gray-700 mb-8">
          <li>✓ Barista certificado</li>
          <li>✓ Café premium artesanal</li>
          <li>✓ Bebidas funcionales</li>
          <li>✓ Repostería sin azúcar</li>
          <li>✓ Máquina espresso</li>
        </ul>

        <button
            data-paquete="Wellness Pro"
            class="seleccionar-paquete mt-auto w-full border-2 border-primary text-primary
                 py-3 rounded-xl font-semibold hover:bg-primary
                 hover:text-white transition"
        >
          Seleccionar paquete
        </button>
      </div>

      <!-- Wellness Premium -->
      <div class="bg-white rounded-2xl shadow-md p-8 flex flex-col">
        <h3 class="text-2xl font-semibold text-primary mb-2 flex items-center gap-2">
            👑 Wellness Premium
        </h3>

        <p class="text-3xl font-bold text-dark mb-6">
          $210 <span class="text-base font-normal text-gray-500">/ persona</span>
        </p>

        <ul class="space-y-3 text-gray-700 mb-8">
          <li>✓ Cata de café saludable</li>
          <li>✓ Múltiples baristas</li>
          <li>✓ Menú personalizado</li>
          <li>✓ Superfood bowls</li>
          <li>✓ Decoración temática</li>
          <li>✓ Atención premium</li>
        </ul>

        <button
            data-paquete="Wellness Premium"
            class="seleccionar-paquete mt-auto w-full border-2 border-primary text-primary
                 py-3 rounded-xl font-semibold hover:bg-primary
                 hover:text-white transition"
        >
          Seleccionar paquete
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".seleccionar-paquete").forEach(btn => {
    btn.addEventListener("click", () => {
      const paquete = btn.getAttribute("data-paquete");
      const reservaSection = document.getElementById("reserva");
      if (reservaSection) {
        reservaSection.scrollIntoView({ behavior: "smooth" });
      }
      // Guardar en sessionStorage para que Reserva.astro lo lea
      sessionStorage.setItem("paqueteSeleccionado", paquete);
      // Intentar setear el select si ya está en el DOM
      const select = document.querySelector("#paquete-select");
      if (select) select.value = paquete;
    });
  });
</script>